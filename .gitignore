/_site/
/_freeze/
/*.deb
.positai

# Editor and OS residue. Do not rely on a contributor's global gitignore --- it
# is invisible from inside the repo, so someone reading this file cannot tell
# these are covered.
.DS_Store
.Rhistory
.Rproj.user/

**/*.quarto_ipynb
/_tests/*.pdf
/_tests/*.log
/_tests/*.tex
/_tests/*_files/
__pycache__/

# Source HTML partials we intentionally track (not build output).
!theme-picker.html
!anchor-landing.html
